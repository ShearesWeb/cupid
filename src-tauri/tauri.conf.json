{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cupid",
  "version": "0.2.3",
  "identifier": "app.shearesweb.cupid",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w ui",
    "beforeBuildCommand": "npm run build -w ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cupid",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ShearesWeb/cupid/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDQTc4RDJGNzQyN0IxMDYKUldRR3NTZDBMNDJuYktYS0QvY3l4eXIxU2hYd21yVDcwL3AzanB0SE5TWGdmekhEdC9DRWo5NGoK"
    }
  }
}
